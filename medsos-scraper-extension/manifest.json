{
  "manifest_version": 3,
  "name": "Social Post Data Collector",
  "description": "Mengambil data dasar postingan Instagram, TikTok, dan Facebook yang terlihat di browser user dan menyimpannya secara lokal.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage", "downloads", "sidePanel"],
  "host_permissions": ["https://www.instagram.com/*", "https://www.tiktok.com/*", "https://www.facebook.com/*", "https://web.facebook.com/*"],
  "action": {
    "default_title": "Social Collector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://www.tiktok.com/*", "https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
